[Unit]
Description=CSE Stock Prediction Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/cse-app
ExecStart=/opt/cse-app/venv/bin/streamlit run app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --browser.gatherUsageStats=false
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
